# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Postgres access for the Drizzle layer (server-only). Use the transaction
# pooler in Vercel; `SET LOCAL ROLE` and JWT claims are scoped to transactions.
# Project Settings → Database → Connection string → Transaction pooler.
POSTGRES_URL=postgresql://postgres.YOUR_PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Server-only: service role key. Never expose to the client.
# Used only by privileged server actions/routes after role/ownership checks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Server-only: one-time bootstrap email for the first database-backed admin.
# It does not grant ongoing admin permissions after bootstrap.
ADMIN_EMAIL=admin@example.com

# Server-only: Vercel AI Gateway credentials for ranking text answers.
# Local development needs an API key; Vercel deployments authenticate with OIDC.
# AI_GATEWAY_API_KEY=your-gateway-key
# Gateway model string in "creator/model" form; pick one from the live catalog.
# RANKING_MODEL=openai/gpt-6-mini

# Optional local/deployment origin used to build magic-link redirect URLs.
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
